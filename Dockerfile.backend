FROM python:3.12-slim
WORKDIR /app
COPY requirements.txt requirements-backend.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements-backend.txt
COPY machine_types.py predict.py pm_features.py ./
COPY backend/ ./backend/
COPY predictive_maintenance_model.pkl feature_names.pkl model_meta.json ./
COPY backtest_model.pkl turbine_meta.pkl ./
COPY bearing_model.pkl bearing_type_model.pkl bearing_meta.pkl ./
COPY wind_turbine_model.pkl wind_turbine_meta.pkl ./
COPY hvac_model.pkl hvac_diag_model.pkl hvac_meta.pkl ./
COPY robot_model.pkl robot_meta.pkl ./
COPY conveyor_model.pkl conveyor_meta.pkl ./
EXPOSE 8000
CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
